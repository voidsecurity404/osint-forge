[
  {
    "id": "spring-actuator-env",
    "name": "Открыт Spring Boot Actuator /env",
    "severity": "high",
    "path": "/actuator/env",
    "desc": "Эндпоинт Spring Boot /actuator/env открыт — раскрываются переменные окружения, конфигурация, а иногда и секреты.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "propertySources",
          "systemEnvironment",
          "activeProfiles"
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  },
  {
    "id": "spring-actuator",
    "name": "Открыт Spring Boot Actuator",
    "severity": "medium",
    "path": "/actuator",
    "desc": "Эндпоинты Spring Boot Actuator доступны без авторизации — раскрывают сведения о приложении и могут дать доступ к опасным действиям.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "_links",
          "self",
          "href"
        ],
        "condition": "and",
        "part": "body"
      }
    ]
  },
  {
    "id": "apache-server-status",
    "name": "Открыт Apache mod_status",
    "severity": "medium",
    "path": "/server-status",
    "desc": "Страница /server-status открыта — видны текущие запросы, IP клиентов и внутренние адреса.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "Apache Server Status",
          "Server uptime",
          "requests currently being processed"
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  },
  {
    "id": "phpinfo",
    "name": "Открыт phpinfo()",
    "severity": "medium",
    "path": "/phpinfo.php",
    "desc": "Страница phpinfo() раскрывает версию PHP, модули, пути и окружение сервера.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "PHP Version",
          "php.ini",
          "Configuration File"
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  },
  {
    "id": "swagger-api-docs",
    "name": "Открыта документация API (Swagger/OpenAPI)",
    "severity": "info",
    "path": "/swagger.json",
    "desc": "Спецификация API доступна публично — по ней видны все эндпоинты и параметры для тестирования.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "swagger",
          "openapi",
          "\"paths\""
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  },
  {
    "id": "graphql-endpoint",
    "name": "Обнаружен эндпоинт GraphQL",
    "severity": "info",
    "path": "/graphql",
    "desc": "Доступен эндпоинт GraphQL — проверьте, включена ли интроспекция и есть ли авторизация.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200,
          400,
          405
        ]
      },
      {
        "type": "word",
        "words": [
          "graphql",
          "\"data\"",
          "\"errors\"",
          "must provide query"
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  },
  {
    "id": "go-pprof",
    "name": "Открыт отладочный эндпоинт Go pprof",
    "severity": "medium",
    "path": "/debug/pprof/",
    "desc": "Эндпоинт /debug/pprof/ открыт — раскрывает внутреннее состояние приложения и позволяет нагружать сервер.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "Types of profiles available",
          "goroutine",
          "/debug/pprof/"
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  },
  {
    "id": "ds-store",
    "name": "Открыт файл .DS_Store",
    "severity": "low",
    "path": "/.DS_Store",
    "desc": "Файл .DS_Store раскрывает имена файлов и папок в каталоге.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "regex",
        "regex": [
          "Bud1",
          "\\x00\\x00\\x00\\x01Bud1"
        ],
        "part": "body"
      }
    ]
  },
  {
    "id": "wordpress-login",
    "name": "Обнаружен WordPress (wp-login)",
    "severity": "info",
    "path": "/wp-login.php",
    "desc": "Страница входа WordPress доступна — проверьте версию, плагины и защиту от перебора паролей.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "user_login",
          "wp-submit",
          "WordPress"
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  },
  {
    "id": "adminer",
    "name": "Открыта панель БД Adminer",
    "severity": "high",
    "path": "/adminer.php",
    "desc": "Adminer доступен из интернета — это прямой вход к базе данных.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "Adminer",
          "login-form",
          "DB driver"
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  },
  {
    "id": "env-backup",
    "name": "Открыт файл конфигурации/резервной копии (.env.bak)",
    "severity": "high",
    "path": "/.env.bak",
    "desc": "Резервная копия .env доступна — в ней могут быть пароли к БД и ключи API.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "regex",
        "regex": [
          "(?i)(APP_KEY|DB_PASSWORD|SECRET|API_KEY)\\s*="
        ],
        "part": "body"
      }
    ]
  },
  {
    "id": "sql-dump",
    "name": "Открыт дамп SQL",
    "severity": "high",
    "path": "/dump.sql",
    "desc": "Дамп базы данных доступен для скачивания — возможна утечка всех данных.",
    "matchers": [
      {
        "type": "status",
        "status": [
          200
        ]
      },
      {
        "type": "word",
        "words": [
          "INSERT INTO",
          "CREATE TABLE",
          "DROP TABLE"
        ],
        "condition": "or",
        "part": "body"
      }
    ]
  }
]
